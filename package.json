{
  "name": "travel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "preview": "npm run build && wrangler d1 migrations apply travel-db --local && wrangler dev",
    "deploy": "wrangler d1 migrations apply travel-db --remote && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
